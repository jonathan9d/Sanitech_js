{
  "name": "sanitech",
  "version": "3.2.0",
  "description": "Sanitech — Gestion des flux & présences.",
  "main": "electron/main.js",
  "author": "Sanitech",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build:web": "node scripts/build-web.mjs",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:apk": "npm run android:build && node scripts/copy-apk.mjs",
    "electron:build": "npm run build:web && npx electron-builder --win",
    "build": "npm run android:apk && npm run electron:build"
  },
  "keywords": [
    "sanitech",
    "presences",
    "pointage",
    "sqlite",
    "offline",
    "pwa"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsqr": "^1.4.0",
    "material-symbols": "^0.46.0",
    "puppeteer-core": "^25.8.0",
    "sql.js": "^1.14.2"
  },
  "build": {
    "appId": "com.sanitech.app",
    "productName": "Sanitech",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sanitech"
    },
    "electronDownload": {
      "cache": "node_modules/.cache/electron"
    }
  },
  "dependencies": {}
}
